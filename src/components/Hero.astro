    // ---- orthographic projection ----
    function project(lat, lng, rotation) {
      const phi = lat * Math.PI / 180;
      const lambda = (lng + rotation) * Math.PI / 180;
      const x = R * Math.cos(phi) * Math.sin(lambda);
      const y = R * Math.sin(phi);
      const z = R * Math.cos(phi) * Math.cos(lambda);
      return { sx: cx + x, sy: cy - y, sz: z, visible: z > -2 };
    }

    let globeRotation = 0;

    // ---- satellites ----
    const satellites = [];
    for (let i = 0; i < 8; i++) {
      const a = (i / 8) * Math.PI * 2 + Math.random() * 0.3;
      const orbitRadius = i < 4 ? R + 15 : R + 28;
      satellites.push({
        x: cx + Math.cos(a) * orbitRadius,
        y: cy + Math.sin(a) * orbitRadius,
        angle: a,
        orbit: orbitRadius,
        speed: (0.002 + Math.random() * 0.003) * (i % 2 === 0 ? 1 : -1),
        size: i < 4 ? 3 : 2.5,
        cooldown: Math.floor(Math.random() * 60),
      });
    }

    let scanAngle = 0;
    const signals = [];

    function spawnSignal(fromX, fromY, toX, toY, type) {
      signals.push({ fromX, fromY, toX, toY, progress: 0, speed: 0.015 + Math.random() * 0.015, type, trail: [] });
    }

    function getStationPos(station, rotation) {
      return project(station.lat, station.lng, rotation);
    }

    function projectContinents(rotation) {
      return continents.map(c => {
        const proj = c.pts.map(p => {
          const pp = project(p[0], p[1], rotation);
          return pp;
        });
        const clipped = [];
        for (let i = 0; i < proj.length; i++) {
          const curr = proj[i];
          const next = proj[(i + 1) % proj.length];
          if (curr.visible) clipped.push({ x: curr.sx, y: curr.sy });
          if (curr.visible !== next.visible) {
            const t = -curr.sz / (next.sz - curr.sz);
            clipped.push({ x: curr.sx + t * (next.sx - curr.sx), y: curr.sy + t * (next.sy - curr.sy) });
          }
        }
        return clipped;
      });
    }

    function drawGraticule(rotation) {
      const step = 72;
      for (let lat = -75; lat <= 75; lat += 15) {
        ctx.beginPath();
        let started = false;
        for (let i = 0; i <= step; i++) {
          const lng = (i / step) * 360 - 180;
          const p = project(lat, lng, rotation);
          if (p.visible) {
            if (!started) { ctx.moveTo(p.sx, p.sy); started = true; }
            else ctx.lineTo(p.sx, p.sy);
          } else started = false;
        }
        ctx.strokeStyle = 'rgba(20, 184, 166, 0.04)';
        ctx.lineWidth = 0.5;
        ctx.stroke();
      }
      for (let lng = -180; lng < 180; lng += 30) {
        ctx.beginPath();
        let started = false;
        for (let i = 0; i <= step; i++) {
          const lat = -90 + (i / step) * 180;
          const p = project(lat, lng, rotation);
          if (p.visible) {
            if (!started) { ctx.moveTo(p.sx, p.sy); started = true; }
            else ctx.lineTo(p.sx, p.sy);
          } else started = false;
        }
        ctx.strokeStyle = 'rgba(20, 184, 166, 0.035)';
        ctx.lineWidth = 0.5;
        ctx.stroke();
      }
    }

    function draw() {
      const now = Date.now();
      ctx.clearRect(0, 0, w, h);

      globeRotation += 0.12;

      // move satellites
      for (const s of satellites) {
        s.angle += s.speed;
        s.x = cx + Math.cos(s.angle) * s.orbit;
        s.y = cy + Math.sin(s.angle) * s.orbit;
        if (s.cooldown > 0) s.cooldown--;
      }

      // signal management
      for (const s of satellites) {
        if (s.cooldown > 0) continue;
        let closest = null, minDist = Infinity;
        for (const st of stations) {
          const pp = getStationPos(st, globeRotation);
          if (!pp.visible) continue;
          const dx = s.x - pp.sx, dy = s.y - pp.sy;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < 90 && d < minDist) { minDist = d; closest = st; }
        }
        if (closest && Math.random() < 0.03) {
          const pp = getStationPos(closest, globeRotation);
          spawnSignal(s.x, s.y, pp.sx, pp.sy, 'downlink');
          s.cooldown = 40 + Math.floor(Math.random() * 40);
        }
      }
      if (Math.random() < 0.02) {
        const st = stations[Math.floor(Math.random() * stations.length)];
        const pp = getStationPos(st, globeRotation);
        if (pp.visible) {
          let closestSat = null, minSatDist = Infinity;
          for (const s of satellites) {
            const dx = s.x - pp.sx, dy = s.y - pp.sy;
            const d = Math.sqrt(dx * dx + dy * dy);
            if (d < 75 && d < minSatDist) { minSatDist = d; closestSat = s; }
          }
          if (closestSat) spawnSignal(pp.sx, pp.sy, closestSat.x, closestSat.y, 'uplink');
        }
      }

      // update signals
      for (let i = signals.length - 1; i >= 0; i--) {
        const sig = signals[i];
        sig.progress += sig.speed;
        sig.trail.push({ x: sig.fromX + (sig.toX - sig.fromX) * sig.progress, y: sig.fromY + (sig.toY - sig.fromY) * sig.progress, life: 1 });
        if (sig.trail.length > 8) sig.trail.shift();
        for (const t of sig.trail) t.life -= 0.12;
        if (sig.progress >= 1) signals.splice(i, 1);
      }

      // ---- globe dark base ----
      ctx.fillStyle = 'rgba(10, 10, 10, 1)';
      ctx.beginPath();
      ctx.arc(cx, cy, R, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = 'rgba(20, 184, 166, 0.06)';
      ctx.lineWidth = 0.5;
      ctx.stroke();

      // ---- pulsing earth glow ----
      const beat = 0.5 + 0.5 * Math.sin(now / 600);
      const beatFast = 0.5 + 0.5 * Math.sin(now / 200);
      const earthGlow = ctx.createRadialGradient(cx, cy, 0, cx, cy, R * 0.6);
      earthGlow.addColorStop(0, `rgba(20, 184, 166, ${0.04 + beat * 0.05})`);
      earthGlow.addColorStop(0.3, `rgba(20, 184, 166, ${0.02 + beat * 0.03})`);
      earthGlow.addColorStop(0.6, `rgba(20, 184, 166, ${0.005 + beat * 0.015})`);
      earthGlow.addColorStop(1, 'transparent');
      ctx.fillStyle = earthGlow;
      ctx.beginPath();
      ctx.arc(cx, cy, R * 0.6, 0, Math.PI * 2);
      ctx.fill();

      // core pulse dot
      ctx.fillStyle = `rgba(255, 255, 255, ${0.02 + beatFast * 0.04})`;
      ctx.beginPath();
      ctx.arc(cx, cy, 5 + beatFast * 2, 0, Math.PI * 2);
      ctx.fill();

      // expanding ring waves
      const wavePhase = (now % 3000) / 3000;
      for (let wv = 0; wv < 3; wv++) {
        const wp = (wavePhase + wv / 3) % 1;
        ctx.strokeStyle = `rgba(20, 184, 166, ${(1 - wp) * 0.07})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(cx, cy, wp * R * 0.65, 0, Math.PI * 2);
        ctx.stroke();
      }

      // ---- graticule ----
      drawGraticule(globeRotation);

      // ---- continent fills & outlines ----
      const clipped = projectContinents(globeRotation);
      for (const poly of clipped) {
        if (poly.length < 3) continue;
        ctx.beginPath();
        ctx.moveTo(poly[0].x, poly[0].y);
        for (let i = 1; i < poly.length; i++) ctx.lineTo(poly[i].x, poly[i].y);
        ctx.closePath();
        ctx.fillStyle = 'rgba(20, 184, 166, 0.035)';
        ctx.fill();
        ctx.strokeStyle = 'rgba(20, 184, 166, 0.12)';
        ctx.lineWidth = 0.8;
        ctx.stroke();
      }

      // ---- orbital rings (atmosphere layers) ----
      for (let i = 0; i < 3; i++) {
        const ringR = R * (0.55 + i * 0.18);
        ctx.strokeStyle = `rgba(20, 184, 166, ${0.05 + i * 0.02})`;
        ctx.lineWidth = i === 1 ? 1 : 0.5;
        ctx.beginPath();
        ctx.arc(cx, cy, ringR, 0, Math.PI * 2);
        ctx.stroke();
      }

      // ---- ground stations ----
      for (const st of stations) {
        const pp = getStationPos(st, globeRotation);
        if (!pp.visible) continue;
        const pulse = 0.5 + 0.5 * Math.sin(now / 1000 + st.lat);
        ctx.fillStyle = `rgba(20, 184, 166, ${0.5 + pulse * 0.3})`;
        ctx.beginPath();
        ctx.arc(pp.sx, pp.sy, 2, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = `rgba(20, 184, 166, ${0.1 + pulse * 0.1})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(pp.sx, pp.sy, 4 + pulse * 1.5, 0, Math.PI * 2);
        ctx.stroke();
      }

      // ---- station-to-satellite connection lines ----
      for (const s of satellites) {
        for (const st of stations) {
          const pp = getStationPos(st, globeRotation);
          if (!pp.visible) continue;
          const dx = s.x - pp.sx, dy = s.y - pp.sy;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < 90) {
            ctx.strokeStyle = `rgba(20, 184, 166, ${(1 - d / 90) * 0.2})`;
            ctx.lineWidth = 0.6;
            ctx.beginPath();
            ctx.moveTo(s.x, s.y);
            ctx.lineTo(pp.sx, pp.sy);
            ctx.stroke();
          }
        }
      }

      // ---- satellites ----
      for (const s of satellites) {
        ctx.fillStyle = 'rgba(20, 184, 166, 0.7)';
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = 'rgba(20, 184, 166, 0.2)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.size + 4, 0, Math.PI * 2);
        ctx.stroke();
      }

      // ---- signal pulses ----
      for (const sig of signals) {
        const sx = sig.fromX + (sig.toX - sig.fromX) * sig.progress;
        const sy = sig.fromY + (sig.toY - sig.fromY) * sig.progress;
        for (const tp of sig.trail) {
          if (tp.life <= 0) continue;
          ctx.fillStyle = `rgba(20, 184, 166, ${tp.life * 0.3})`;
          ctx.beginPath();
          ctx.arc(tp.x, tp.y, 1.5 * tp.life, 0, Math.PI * 2);
          ctx.fill();
        }
        const pulseAlpha = 0.6 + 0.4 * Math.sin(now / 80 + sig.progress * 10);
        ctx.fillStyle = `rgba(255, 255, 255, ${pulseAlpha})`;
        ctx.beginPath();
        ctx.arc(sx, sy, 2.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = `rgba(20, 184, 166, ${pulseAlpha * 0.2})`;
        ctx.beginPath();
        ctx.arc(sx, sy, 5, 0, Math.PI * 2);
        ctx.fill();
      }

      // ---- scan radar ----
      scanAngle += 0.008;
      ctx.strokeStyle = 'rgba(20, 184, 166, 0.4)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(cx, cy, R + 5, scanAngle, scanAngle + 0.8);
      ctx.stroke();
      ctx.strokeStyle = 'rgba(20, 184, 166, 0.15)';
      ctx.lineWidth = 0.5;
      ctx.beginPath();
      ctx.arc(cx, cy, R + 5, scanAngle + 0.8, scanAngle + Math.PI * 2);
      ctx.stroke();
      const wedge = ctx.createConicGradient(scanAngle, cx, cy);
      wedge.addColorStop(0, 'rgba(20, 184, 166, 0.04)');
      wedge.addColorStop(0.15, 'rgba(20, 184, 166, 0.01)');
      wedge.addColorStop(1, 'transparent');
      ctx.fillStyle = wedge;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.arc(cx, cy, R + 10, scanAngle, scanAngle + 0.8);
      ctx.closePath();
      ctx.fill();

      // ---- corner brackets ----
      const bracketSize = 16, gap = 10;
      ctx.strokeStyle = 'rgba(20, 184, 166, 0.18)';
      ctx.lineWidth = 1;
      for (const [bx, by, sx, sy] of [[gap, gap, 1, 1], [w - gap, gap, -1, 1], [gap, h - gap, 1, -1], [w - gap, h - gap, -1, -1]]) {
        ctx.beginPath();
        ctx.moveTo(bx + sx * bracketSize, by);
        ctx.lineTo(bx, by);
        ctx.lineTo(bx, by + sy * bracketSize);
        ctx.stroke();
      }

      // ---- text overlay ----
      ctx.fillStyle = 'rgba(20, 184, 166, 0.06)';
      ctx.font = '7px Inter, monospace';
      ctx.textAlign = 'center';
      ctx.fillText('GLOBETRK v1.0', cx, cy + R + 8);
      ctx.fillText('SAT: ' + satellites.length + '  STN: ' + stations.length, cx, cy + R + 18);
      ctx.fillText('STATUS: ONLINE', cx, cy + R + 28);

      requestAnimationFrame(draw);
    }

    draw();
  })();
</script>
