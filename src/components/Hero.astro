<section class="hero-bg min-h-screen flex flex-col justify-center px-6 md:px-[8%] overflow-hidden pt-20 md:pt-24">
  <div class="hero-glow"></div>

  <div class="max-w-5xl mx-auto w-full relative z-10 grid md:grid-cols-2 gap-12 items-center">
    <div>
      <div class="reveal mb-2">
        <span class="text-sm sm:text-base text-text-primary font-mono tracking-wide">Hello &mdash;</span>
      </div>

      <h1 class="hero-name reveal">
        Sheng<br />
        <span class="text-accent">Huang</span>
      </h1>

      <p class="text-base sm:text-lg text-text-primary font-medium max-w-xl leading-relaxed mt-5 mb-10 reveal">
        Software Engineer &middot; AI/ML Researcher &middot; MIT CS
      </p>

      <div class="flex items-center gap-6 reveal">
        <a
          href="/resume.pdf"
          download
          class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium bg-accent text-base rounded-md hover:opacity-90 transition-opacity duration-200"
        >
          Resume
        </a>
        <a
          href="#projects"
          class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200"
        >
          View work &rarr;
        </a>
      </div>
    </div>

    <div class="hidden md:flex items-center justify-center reveal">
      <div class="relative flex items-center justify-center">
        <canvas id="hud-canvas" width="340" height="340" class="relative z-10"></canvas>
        <div class="absolute inset-0 rounded-full border border-accent/10"></div>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto w-full mt-auto pb-10 relative z-10 reveal">
    <div class="flex items-center gap-6 text-text-muted">
      <span class="text-xs uppercase tracking-widest text-text-muted/40">Connect</span>
      <div class="h-px flex-1 bg-border max-w-12"></div>
      <a
        href="https://linkedin.com/in/your-username"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-text-secondary hover:text-text-primary transition-colors duration-200"
      >
        LinkedIn
      </a>
      <a
        href="mailto:shengh@mit.edu"
        class="text-xs text-text-secondary hover:text-text-primary transition-colors duration-200"
      >
        Email
      </a>
    </div>
  </div>
</section>

<script>
  (function() {
    const canvas = document.getElementById('hud-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const w = 340, h = 340, cx = w / 2, cy = h / 2;

    const nodes = [];
    for (let i = 0; i < 70; i++) {
      const angle = Math.random() * 2 * Math.PI;
      const radius = 30 + Math.random() * 120;
      nodes.push({
        x: cx + Math.cos(angle) * radius,
        y: cy + Math.sin(angle) * radius,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
        r: 1 + Math.random() * 2,
        phase: Math.random() * Math.PI * 2,
      });
    }

    let scanAngle = 0;

    function draw() {
      ctx.clearRect(0, 0, w, h);
      for (const n of nodes) {
        n.x += n.vx;
        n.y += n.vy;
        const dx = n.x - cx, dy = n.y - cy;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 30 || dist > 130) { n.vx *= -1; n.vy *= -1; }
      }

      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < 80) {
            ctx.strokeStyle = `rgba(245, 158, 11, ${(1 - d / 80) * 0.15})`;
            ctx.lineWidth = 0.5;
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }
      }

      for (const n of nodes) {
        const pulse = 0.5 + 0.5 * Math.sin(Date.now() / 1000 + n.phase);
        ctx.fillStyle = `rgba(245, 158, 11, ${0.3 + pulse * 0.3})`;
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fill();
      }

      for (let i = 0; i < 3; i++) {
        const ringR = 70 + i * 30;
        ctx.strokeStyle = `rgba(245, 158, 11, ${0.06 + i * 0.02})`;
        ctx.lineWidth = 0.5;
        ctx.beginPath();
        ctx.arc(cx, cy, ringR, 0, Math.PI * 2);
        ctx.stroke();
      }

      scanAngle += 0.008;
      ctx.strokeStyle = 'rgba(245, 158, 11, 0.4)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(cx, cy, 120, scanAngle, scanAngle + 0.8);
      ctx.stroke();
      ctx.strokeStyle = 'rgba(245, 158, 11, 0.15)';
      ctx.lineWidth = 0.5;
      ctx.beginPath();
      ctx.arc(cx, cy, 120, scanAngle + 0.8, scanAngle + Math.PI * 2);
      ctx.stroke();

      const grad = ctx.createConicGradient(scanAngle, cx, cy);
      grad.addColorStop(0, 'rgba(245, 158, 11, 0.04)');
      grad.addColorStop(0.15, 'rgba(245, 158, 11, 0.01)');
      grad.addColorStop(1, 'transparent');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.arc(cx, cy, 130, scanAngle, scanAngle + 0.8);
      ctx.closePath();
      ctx.fill();

      const bracketSize = 18, gap = 12;
      ctx.strokeStyle = 'rgba(245, 158, 11, 0.2)';
      ctx.lineWidth = 1;
      const brackets = [
        [gap, gap, 1, 1], [w - gap, gap, -1, 1],
        [gap, h - gap, 1, -1], [w - gap, h - gap, -1, -1],
      ];
      for (const [bx, by, sx, sy] of brackets) {
        ctx.beginPath();
        ctx.moveTo(bx + sx * bracketSize, by);
        ctx.lineTo(bx, by);
        ctx.lineTo(bx, by + sy * bracketSize);
        ctx.stroke();
      }

      ctx.fillStyle = 'rgba(245, 158, 11, 0.06)';
      ctx.font = '7px Inter, monospace';
      ctx.textAlign = 'center';
      ctx.fillText('SYS v2.4', cx, cy + 52);
      ctx.fillText('NODES: ' + nodes.length, cx, cy + 62);
      ctx.fillText('STATUS: ONLINE', cx, cy + 72);

      requestAnimationFrame(draw);
    }

    draw();
  })();
</script>
