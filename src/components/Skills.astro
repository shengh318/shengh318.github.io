---
import { skills } from '../data/projects';

const icons: Record<string, string> = {
  python: 'M5 2h6a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM4 6h8',
  typescript: 'M4 3h8a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM6 8h4M8 6v4',
  cplusplus: 'M5 3h6a2 2 0 0 1 2 2v2l-3 1 3 1v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2l3-1-3-1V5a2 2 0 0 1 2-2z',
  database: 'M3 5c0-1.1 2.7-2 6-2s6 .9 6 2v6c0 1.1-2.7 2-6 2s-6-.9-6-2V5zM3 8c0 1.1 2.7 2 6 2s6-.9 6-2',
  robot: 'M5 6h6a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zM8 4V2M6.5 9h3',
  git: 'M6 3v8a2 2 0 0 0 2 2h2M6 5l-3 2 3 2',
  terminal: 'M4 5l3 3-3 3M9 11h3',
  container: 'M3 4a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4zM3 7h10M3 10h10',
  chip: 'M5 5h6v6H5V5zM4 8H2M14 8h-2M8 4V2M8 14v-2',
  cpu: 'M4 5a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5zM2 8H1M15 8h-1M8 3V1M8 15v-2',
  wifi: 'M4 6c2-1.5 6-1.5 8 0M5.5 8.5c1.5-1 4-1 5.5 0M7 11c.5-.5 1.5-.5 2 0',
  eye: 'M2 8s2.5-4.5 7-4.5 7 4.5 7 4.5-2.5 4.5-7 4.5S2 8 2 8zM9 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0z',
};

const categories = [
  { key: 'languages', label: 'Languages', tag: 'LANG' },
  { key: 'tools', label: 'Frameworks & Tools', tag: 'TOOL' },
  { key: 'hardware', label: 'Hardware & Embedded', tag: 'HWR' },
] as const;
---

<section id="skills" class="section-bg relative py-24 md:py-32 px-6 md:px-[8%] border-t border-border overflow-hidden">
  <div class="section-bg-glow" style="top: 40%; left: 20%;"></div>
  <div class="section-bg-glow" style="top: 60%; left: 80%;"></div>

  <div class="max-w-5xl mx-auto relative z-10">
    <div class="section-title reveal">
      <span class="section-title-text">_SKILLS</span>
      <span class="section-title-line"></span>
    </div>

    <div class="skills-dashboard reveal-stagger">
      <div class="hud-core" aria-hidden="true">
        <canvas id="skills-canvas" class="skills-canvas"></canvas>
        <div class="hud-core-borders"></div>
        <div class="hud-core-status">SYS: ACTIVE</div>
      </div>

      {categories.map((cat, ci) => (
        <div class="holo-panel" style="--panel-idx: {ci}">
          <div class="holo-panel-header">
            <span class="holo-panel-tag">[{cat.tag}]</span>
            <span class="holo-panel-title">{cat.label}</span>
          </div>
          <div class="holo-panel-body">
            {skills[cat.key].map((skill, i) => (
              <div class="skill-entry" style="--idx: {i}">
                <svg class="skill-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                  <path d={icons[skill.icon] || icons.chip} />
                </svg>
                <span class="skill-name">{skill.name}</span>
                <div class="skill-meter">
                  <div class="skill-meter-fill" style="--pct: {skill.percent}"></div>
                </div>
                <span class="skill-pct">{skill.percent}%</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
(function() {
  const canvas = document.getElementById('skills-canvas');
  if (!canvas) return;

  function initCanvas() {
    const container = canvas.parentElement;
    if (!container) return;
    const isMobile = window.matchMedia('(max-width: 767px)').matches;
    const maxSize = isMobile ? 200 : 320;
    const size = Math.min(container.getBoundingClientRect().width, container.getBoundingClientRect().height, maxSize);
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = size * dpr;
    canvas.height = size * dpr;
    canvas.style.width = size + 'px';
    canvas.style.height = size + 'px';

    const ctx = canvas.getContext('2d');
    ctx.scale(dpr, dpr);

    const cx = size / 2;
    const cy = size / 2;
    const R = size * 0.38;
    let scanAngle = 0;

    const numParticles = isMobile ? 8 : 22;
    const particles = Array.from({ length: numParticles }, () => ({
      x: Math.random() * size,
      y: Math.random() * size,
      vx: (Math.random() - 0.5) * 0.25,
      vy: (Math.random() - 0.5) * 0.25,
      r: Math.random() * 1.5 + 0.5,
      a: Math.random() * 0.35 + 0.08,
    }));

    const numOrbiters = isMobile ? 4 : 6;
    const orbiters = Array.from({ length: numOrbiters }, (_, i) => ({
      angle: (i / numOrbiters) * Math.PI * 2 + Math.random() * 0.5,
      radius: R * (0.5 + Math.random() * 0.3),
      speed: (0.002 + Math.random() * 0.002) * (i % 2 === 0 ? 1 : -1),
      size: 1.5 + Math.random() * 1.5,
    }));

    let animId;

    function draw() {
      const now = Date.now();
      ctx.clearRect(0, 0, size, size);

      for (let i = 0; i < 4; i++) {
        const rr = R * (0.2 + i * 0.24);
        ctx.beginPath();
        ctx.arc(cx, cy, rr, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(20, 184, 166, ${0.03 + i * 0.02})`;
        ctx.lineWidth = 0.3 + i * 0.15;
        if (i % 2 === 0) ctx.setLineDash([3, 7]);
        else ctx.setLineDash([]);
        ctx.stroke();
      }
      ctx.setLineDash([]);

      const rot = now / 2500;
      for (let i = 0; i < 2; i++) {
        const rr = R * (0.35 + i * 0.28);
        const offset = rot * (i === 0 ? 1 : -1);
        ctx.beginPath();
        ctx.arc(cx, cy, rr, offset, offset + Math.PI * 1.2);
        ctx.strokeStyle = `rgba(20, 184, 166, ${0.12 + i * 0.08})`;
        ctx.lineWidth = 1;
        ctx.stroke();
      }

      scanAngle += 0.01;
      const sweepR = R * 0.85;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.arc(cx, cy, sweepR, scanAngle - 0.12, scanAngle + 0.12);
      ctx.closePath();
      ctx.fillStyle = 'rgba(20, 184, 166, 0.02)';
      ctx.fill();
      ctx.strokeStyle = 'rgba(20, 184, 166, 0.2)';
      ctx.lineWidth = 0.8;
      ctx.beginPath();
      ctx.arc(cx, cy, sweepR, scanAngle - 0.12, scanAngle + 0.12);
      ctx.stroke();

      const pulse = 0.5 + 0.5 * Math.sin(now / 900);
      const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, R * 0.35);
      grad.addColorStop(0, `rgba(20, 184, 166, ${0.05 + pulse * 0.06})`);
      grad.addColorStop(1, 'transparent');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(cx, cy, R * 0.35, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = `rgba(20, 184, 166, ${0.4 + pulse * 0.25})`;
      ctx.beginPath();
      ctx.arc(cx, cy, 2.5 + pulse * 1.5, 0, Math.PI * 2);
      ctx.fill();

      const wavePhase = (now % 3000) / 3000;
      for (let w = 0; w < 2; w++) {
        const wp = (wavePhase + w / 2) % 1;
        ctx.strokeStyle = `rgba(20, 184, 166, ${(1 - wp) * 0.05})`;
        ctx.lineWidth = 0.8;
        ctx.beginPath();
        ctx.arc(cx, cy, wp * R * 0.5, 0, Math.PI * 2);
        ctx.stroke();
      }

      for (const orb of orbiters) {
        orb.angle += orb.speed;
        const x = cx + Math.cos(orb.angle) * orb.radius;
        const y = cy + Math.sin(orb.angle) * orb.radius;

        ctx.strokeStyle = 'rgba(20, 184, 166, 0.05)';
        ctx.lineWidth = 0.4;
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.lineTo(x, y);
        ctx.stroke();

        ctx.fillStyle = 'rgba(20, 184, 166, 0.45)';
        ctx.beginPath();
        ctx.arc(x, y, orb.size, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = 'rgba(20, 184, 166, 0.08)';
        ctx.beginPath();
        ctx.arc(x, y, orb.size * 3, 0, Math.PI * 2);
        ctx.fill();
      }

      for (const p of particles) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > size) p.vx *= -1;
        if (p.y < 0 || p.y > size) p.vy *= -1;
        ctx.fillStyle = `rgba(20, 184, 166, ${p.a})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }

      animId = requestAnimationFrame(draw);
    }

    draw();

    const stopObserver = new IntersectionObserver(function(entries) {
      for (var e of entries) {
        if (!e.isIntersecting && animId) {
          cancelAnimationFrame(animId);
          animId = 0;
        } else if (e.isIntersecting && !animId) {
          draw();
        }
      }
    }, { threshold: 0 });
    stopObserver.observe(canvas);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() { requestAnimationFrame(initCanvas); });
  } else {
    requestAnimationFrame(initCanvas);
  }
})();
</script>
