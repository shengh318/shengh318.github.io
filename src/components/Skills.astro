<script>
(function() {
  const canvas = document.getElementById('skills-reactor');
  if (!canvas) return;

  let animId;
  let size = 180;

  function initReactor() {
    const container = canvas.parentElement;
    if (!container) return;

    const isMobile = window.matchMedia('(max-width: 767px)').matches;
    const isTablet = window.matchMedia('(max-width: 1023px)').matches;
    size = isMobile ? 100 : (isTablet ? 140 : 180);

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = size * dpr;
    canvas.height = size * dpr;
    canvas.style.width = size + 'px';
    canvas.style.height = size + 'px';

    const ctx = canvas.getContext('2d');
    ctx.scale(dpr, dpr);

    const cx = size / 2;
    const cy = size / 2;
    const R = size * 0.42;
    let scanAngle = 0;

    function draw() {
      const now = Date.now();
      ctx.clearRect(0, 0, size, size);

      for (let i = 0; i < 4; i++) {
        const rr = R * (0.25 + i * 0.22);
        ctx.beginPath();
        ctx.arc(cx, cy, rr, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(20, 184, 166, ${0.04 + i * 0.035})`;
        ctx.lineWidth = 0.3 + i * 0.12;
        if (i % 2 === 0) {
          ctx.setLineDash([3, 6]);
        } else {
          ctx.setLineDash([]);
        }
        ctx.stroke();
      }
      ctx.setLineDash([]);

      const rot = now / 3000;
      for (let i = 0; i < 2; i++) {
        const rr = R * (0.4 + i * 0.25);
        const offset = rot * (i === 0 ? 1 : -1);
        ctx.beginPath();
        ctx.arc(cx, cy, rr, offset, offset + Math.PI * 1.1);
        ctx.strokeStyle = `rgba(20, 184, 166, ${0.12 + i * 0.06})`;
        ctx.lineWidth = 1.2;
        ctx.stroke();
      }

      scanAngle += 0.008;
      const sweepR = R * 0.9;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.arc(cx, cy, sweepR, scanAngle - 0.1, scanAngle + 0.1);
      ctx.closePath();
      ctx.fillStyle = 'rgba(20, 184, 166, 0.015)';
      ctx.fill();
      ctx.strokeStyle = 'rgba(20, 184, 166, 0.15)';
      ctx.lineWidth = 0.6;
      ctx.beginPath();
      ctx.arc(cx, cy, sweepR, scanAngle - 0.1, scanAngle + 0.1);
      ctx.stroke();

      const pulse = 0.5 + 0.5 * Math.sin(now / 1000);
      const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, R * 0.4);
      grad.addColorStop(0, `rgba(20, 184, 166, ${0.06 + pulse * 0.08})`);
      grad.addColorStop(0.4, `rgba(20, 184, 166, ${0.03 + pulse * 0.04})`);
      grad.addColorStop(1, 'transparent');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(cx, cy, R * 0.4, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = `rgba(20, 184, 166, ${0.5 + pulse * 0.3})`;
      ctx.shadowColor = 'rgba(20, 184, 166, 0.4)';
      ctx.shadowBlur = 12;
      ctx.beginPath();
      ctx.arc(cx, cy, 2.5 + pulse * 1.2, 0, Math.PI * 2);
      ctx.fill();
      ctx.shadowBlur = 0;

      const wavePhase = (now % 3000) / 3000;
      for (let w = 0; w < 2; w++) {
        const wp = (wavePhase + w / 2) % 1;
        ctx.strokeStyle = `rgba(20, 184, 166, ${(1 - wp) * 0.04})`;
        ctx.lineWidth = 0.6;
        ctx.beginPath();
        ctx.arc(cx, cy, wp * R * 0.55, 0, Math.PI * 2);
        ctx.stroke();
      }

      const numOrbiters = isMobile ? 3 : 5;
      for (let o = 0; o < numOrbiters; o++) {
        const angle = (now / 4000) * (o % 2 === 0 ? 1 : -1) + (o / numOrbiters) * Math.PI * 2;
        const radius = R * (0.35 + Math.sin(now / 2000 + o) * 0.15);
        const x = cx + Math.cos(angle) * radius;
        const y = cy + Math.sin(angle) * radius;
        ctx.fillStyle = `rgba(20, 184, 166, ${0.25 + 0.15 * Math.sin(now / 800 + o)})`;
        ctx.beginPath();
        ctx.arc(x, y, 1.2 + 0.5 * Math.sin(now / 600 + o), 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = 'rgba(20, 184, 166, 0.04)';
        ctx.lineWidth = 0.3;
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.lineTo(x, y);
        ctx.stroke();
      }

      animId = requestAnimationFrame(draw);
    }

    draw();
  }

  const observer = new IntersectionObserver(function(entries) {
    for (var e of entries) {
      if (!e.isIntersecting && animId) {
        cancelAnimationFrame(animId);
        animId = 0;
      } else if (e.isIntersecting && !animId) {
        initReactor();
      }
    }
  }, { threshold: 0 });
  observer.observe(canvas);

  var resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function() {
      if (animId) {
        cancelAnimationFrame(animId);
        animId = 0;
      }
      initReactor();
    }, 200);
  });
})();
</script>
