---
const navLinks = [
  { href: '/#about', label: 'About' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#projects', label: 'Projects' },
];
---

<header class="header fixed top-0 left-0 w-full z-50 transition-all duration-300 border-b border-transparent px-6 md:px-[8%]">
  <div class="max-w-5xl mx-auto flex items-center justify-between h-16 md:h-20">
    <a href="/" class="text-lg font-semibold tracking-tight text-text-primary">
      SH
    </a>
    <nav class="flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/resume.pdf"
        download
        class="text-sm font-medium text-accent hover:opacity-70 transition-opacity duration-200"
      >
        Resume →
      </a>
    </nav>
  </div>
</header>
