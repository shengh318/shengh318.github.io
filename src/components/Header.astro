---
const navLinks = [
  { href: '/#about', label: 'About' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#projects', label: 'Projects' },
];

const mobileNavLinks = [
  { href: '/#about', label: 'About' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="header fixed top-0 left-0 w-full z-50 transition-all duration-300 border-b border-transparent px-6 md:px-[8%]">
  <div class="max-w-5xl mx-auto flex items-center justify-between h-16 md:h-20">
    <a href="/" class="text-lg font-semibold tracking-tight text-text-primary">
      SH
    </a>
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/resume.pdf"
        download
        class="text-sm font-medium text-accent hover:opacity-70 transition-opacity duration-200"
      >
        Resume →
      </a>
    </nav>
    <button id="menu-toggle" class="md:hidden flex items-center justify-center w-11 h-11 text-text-secondary hover:text-text-primary transition-colors duration-200" aria-label="Toggle menu">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line class="menu-line-top" x1="3" y1="6" x2="19" y2="6"/>
        <line class="menu-line-mid" x1="3" y1="11" x2="19" y2="11"/>
        <line class="menu-line-bot" x1="3" y1="16" x2="19" y2="16"/>
      </svg>
    </button>
  </div>
</header>

<div id="mobile-menu" class="fixed inset-0 z-40 bg-base/95 backdrop-blur-md flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden">
  {mobileNavLinks.map((link) => (
    <a
      href={link.href}
      class="mobile-nav-link text-2xl font-medium text-text-secondary hover:text-text-primary transition-colors duration-200 py-2"
    >
      {link.label}
    </a>
  ))}
  <a
    href="/resume.pdf"
    download
    class="mobile-nav-link text-xl font-medium text-accent hover:opacity-70 transition-opacity duration-200 mt-4 py-2"
  >
    Resume →
  </a>
</div>

<style>
  #mobile-menu.open {
    opacity: 1;
    pointer-events: auto;
  }
  #menu-toggle.active .menu-line-top {
    transform: translateY(5px) rotate(45deg);
  }
  #menu-toggle.active .menu-line-mid {
    opacity: 0;
  }
  #menu-toggle.active .menu-line-bot {
    transform: translateY(-5px) rotate(-45deg);
  }
  .menu-line-top,
  .menu-line-mid,
  .menu-line-bot {
    transition: transform 0.3s, opacity 0.3s;
    transform-origin: center;
  }
</style>
