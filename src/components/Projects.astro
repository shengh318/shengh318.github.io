---
import { projects } from '../data/projects';
import HudRepulsor from './hud/HudRepulsor.astro';
---

<section id="projects" class="section-bg py-24 md:py-32 px-6 md:px-[8%] border-t border-border">
  <HudRepulsor />
  <div class="section-bg-glow" style="top: 30%; right: -5%;"></div>
  <div class="max-w-5xl mx-auto">
    <div class="reveal section-content">
      <div class="section-title">
        <span class="section-title-text">Projects</span>
        <span class="section-title-line"></span>
      </div>

      <div class="grid md:grid-cols-2 gap-5">
        {projects.map((project) => (
          <div class="project-card project-card-float" data-tilt>
            <div class="project-card-inner project-card-sheen bg-card border border-border rounded-lg p-6 md:p-8 hover:border-accent/20 transition-colors duration-300">
              <h3 class="text-base font-semibold text-text-primary mb-2 relative z-10">{project.name}</h3>
              <p class="text-sm text-text-secondary leading-relaxed mb-4 relative z-10">{project.description}</p>
              <div class="flex flex-wrap gap-x-2.5 gap-y-1 relative z-10">
                {project.skills.map((skill) => (
                  <span class="text-xs text-text-muted">{skill.label}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    if (window.matchMedia('(hover: none) and (pointer: coarse)').matches) return;

    const cards = document.querySelectorAll('[data-tilt]');

    cards.forEach((card) => {
      const inner = card.querySelector('.project-card-inner');

      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width;
        const y = (e.clientY - rect.top) / rect.height;
        const tiltX = (y - 0.5) * -12;
        const tiltY = (x - 0.5) * 12;

        inner.style.transform = `perspective(800px) rotateX(${tiltX}deg) rotateY(${tiltY}deg) scale(1.02)`;
        inner.style.setProperty('--sheen-x', `${x * 100}%`);
        inner.style.setProperty('--sheen-y', `${y * 100}%`);
      });

      card.addEventListener('mouseleave', () => {
        inner.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) scale(1)';
      });
    });
  })();
</script>
