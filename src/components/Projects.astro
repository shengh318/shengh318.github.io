---
import { projects } from '../data/projects';
---

<section id="projects" class="py-24 md:py-32 px-6 md:px-[8%] border-t border-border">
  <div class="max-w-5xl mx-auto">
    <div class="reveal">
      <h2 class="text-xs uppercase tracking-widest text-text-muted/50 mb-12 font-mono">Projects</h2>

      <div class="grid md:grid-cols-2 gap-px bg-border">
        {projects.map((project) => (
          <div class="bg-base p-6 md:p-8 hover:bg-surface transition-colors duration-200">
            <h3 class="text-base font-semibold text-text-primary mb-2">{project.name}</h3>
            <p class="text-sm text-text-secondary leading-relaxed mb-4">{project.description}</p>
            <div class="flex flex-wrap gap-x-2.5 gap-y-1">
              {project.skills.map((skill) => (
                <span class="text-xs text-text-muted">{skill.label}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
