---
import { education } from '../data/projects';
---

<section id="education" class="section-bg relative py-24 md:py-32 px-6 md:px-[8%] border-t border-border overflow-hidden">
  <div class="section-bg-glow" style="bottom: 10%; left: -15%;"></div>
  <div class="max-w-5xl mx-auto relative z-10">
    <div class="reveal section-content">
      <div class="section-title">
        <span class="section-title-text">Education</span>
        <span class="section-title-line"></span>
        <span class="edu-tracker">[CREDENTIALS: {education.length}]</span>
      </div>

      <div class="edu-grid reveal-stagger">
        {education.map((edu, i) => (
          <div class="edu-card">
            <div class="edu-sheen"></div>
            <div class="edu-card-inner">
              <div class="edu-bracket edu-bracket-tl"></div>
              <div class="edu-bracket edu-bracket-tr"></div>
              <div class="edu-bracket edu-bracket-bl"></div>
              <div class="edu-bracket edu-bracket-br"></div>

              <div class="edu-top-bar">
                <div class="edu-top-left">
                  <svg class="edu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                  </svg>
                  <span class="edu-log-label">[CRED-{String(i + 1).padStart(2, '0')}]</span>
                </div>
                <span class="edu-status-badge">
                  <span class="edu-status-dot"></span>
                  COMPLETED
                </span>
              </div>

              <h3 class="edu-degree">{edu.degree}</h3>
              <p class="edu-school">{edu.school}</p>

              <div class="edu-metrics">
                <div class="edu-gpa">
                  <span class="edu-gpa-label">GPA</span>
                  <span class="edu-gpa-value">{edu.gpa}</span>
                </div>
                <div class="edu-divider-dot"></div>
                <span class="edu-period">{edu.period}</span>
              </div>

              {edu.url && (
                <a
                  href={edu.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="edu-pub-link"
                >
                  <svg class="edu-pub-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                    <circle cx="12" cy="12" r="4"/>
                  </svg>
                  <span>VIEW PUBLICATION</span>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .edu-tracker {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.6rem;
    color: rgba(20, 184, 166, 0.75);
    letter-spacing: 0.08em;
    flex-shrink: 0;
    font-weight: 600;
    text-shadow: 0 0 8px rgba(20, 184, 166, 0.25);
  }

  .edu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .edu-card {
    position: relative;
    background: rgba(26, 26, 26, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(20, 184, 166, 0.15);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.4s, box-shadow 0.4s;
  }

  .edu-card:hover {
    border-color: rgba(20, 184, 166, 0.3);
    box-shadow: 0 0 40px rgba(20, 184, 166, 0.06), 0 0 80px rgba(20, 184, 166, 0.03);
  }

  .edu-sheen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgba(20, 184, 166, 0.06) 45%,
      rgba(20, 184, 166, 0.06) 50%,
      rgba(20, 184, 166, 0.06) 55%,
      transparent 70%
    );
    background-size: 200% 200%;
    transition: opacity 0.5s;
  }

  .edu-card:hover .edu-sheen {
    opacity: 1;
    animation: eduSheenSweep 1.5s ease-in-out;
  }

  @keyframes eduSheenSweep {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .edu-card-inner {
    position: relative;
    z-index: 1;
    padding: 1.5rem;
  }

  .edu-bracket {
    position: absolute;
    width: 14px;
    height: 14px;
    z-index: 2;
  }

  .edu-bracket::before,
  .edu-bracket::after {
    content: '';
    position: absolute;
    background: rgba(20, 184, 166, 0.35);
    border-radius: 1px;
    transition: background 0.3s;
  }

  .edu-card:hover .edu-bracket::before,
  .edu-card:hover .edu-bracket::after {
    background: rgba(20, 184, 166, 0.7);
  }

  .edu-bracket-tl { top: 8px; left: 8px; }
  .edu-bracket-tl::before { top: 0; left: 0; width: 12px; height: 1.5px; }
  .edu-bracket-tl::after { top: 0; left: 0; width: 1.5px; height: 12px; }
  .edu-bracket-tr { top: 8px; right: 8px; }
  .edu-bracket-tr::before { top: 0; right: 0; width: 12px; height: 1.5px; }
  .edu-bracket-tr::after { top: 0; right: 0; width: 1.5px; height: 12px; }
  .edu-bracket-bl { bottom: 8px; left: 8px; }
  .edu-bracket-bl::before { bottom: 0; left: 0; width: 12px; height: 1.5px; }
  .edu-bracket-bl::after { bottom: 0; left: 0; width: 1.5px; height: 12px; }
  .edu-bracket-br { bottom: 8px; right: 8px; }
  .edu-bracket-br::before { bottom: 0; right: 0; width: 12px; height: 1.5px; }
  .edu-bracket-br::after { bottom: 0; right: 0; width: 1.5px; height: 12px; }

  .edu-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(20, 184, 166, 0.1);
  }

  .edu-top-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .edu-icon {
    width: 18px;
    height: 18px;
    color: rgba(20, 184, 166, 0.6);
    transition: color 0.3s, filter 0.3s;
  }

  .edu-card:hover .edu-icon {
    color: rgba(20, 184, 166, 0.9);
    filter: drop-shadow(0 0 6px rgba(20, 184, 166, 0.4));
  }

  .edu-log-label {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.6rem;
    color: rgba(20, 184, 166, 0.45);
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .edu-status-badge {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    color: rgba(34, 197, 94, 0.7);
  }

  .edu-status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #22c55e;
    animation: eduStatusPulse 2s ease-in-out infinite;
  }

  @keyframes eduStatusPulse {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  .edu-degree {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin-bottom: 0.25rem;
  }

  .edu-school {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
    line-height: 1.4;
  }

  .edu-metrics {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .edu-gpa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, rgba(20, 184, 166, 0.12), rgba(20, 184, 166, 0.08));
    border: 1px solid rgba(20, 184, 166, 0.2);
    border-radius: 8px;
    padding: 0.35rem 0.85rem;
    font-family: 'Courier New', Courier, monospace;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .edu-card:hover .edu-gpa {
    border-color: rgba(20, 184, 166, 0.35);
    box-shadow: 0 0 16px rgba(20, 184, 166, 0.1);
  }

  .edu-gpa-label {
    font-size: 0.6rem;
    color: rgba(20, 184, 166, 0.6);
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .edu-gpa-value {
    font-size: 0.9rem;
    font-weight: 700;
    color: #14b8a6;
    text-shadow: 0 0 12px rgba(20, 184, 166, 0.4);
  }

  .edu-divider-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(20, 184, 166, 0.3);
    flex-shrink: 0;
  }

  .edu-period {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.65rem;
    font-weight: 600;
    color: rgba(20, 184, 166, 0.65);
    letter-spacing: 0.06em;
    text-shadow: 0 0 8px rgba(20, 184, 166, 0.15);
  }

  .edu-pub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(20, 184, 166, 0.08);
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.6rem;
    font-weight: 600;
    color: rgba(20, 184, 166, 0.5);
    text-decoration: none;
    letter-spacing: 0.06em;
    transition: color 0.3s;
  }

  .edu-pub-link:hover {
    color: rgba(20, 184, 166, 0.9);
  }

  .edu-pub-icon {
    width: 14px;
    height: 14px;
    transition: transform 0.3s;
  }

  .edu-pub-link:hover .edu-pub-icon {
    transform: rotate(90deg);
  }

  @media (max-width: 1023px) {
    .edu-grid {
      grid-template-columns: 1fr;
    }

    .edu-tracker {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .edu-card-inner {
      padding: 1.25rem;
    }

    .edu-degree {
      font-size: 0.9rem;
    }

    .edu-school {
      font-size: 0.75rem;
    }

    .edu-tracker {
      display: none;
    }
  }
</style>
