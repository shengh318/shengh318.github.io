---
import HudComm from './hud/HudComm.astro';
---

<section id="contact" class="section-bg py-24 md:py-32 px-6 md:px-[8%] border-t border-border">
  <HudComm />
  <div class="section-bg-glow" style="bottom: 0%; left: 20%;"></div>
  <div class="max-w-5xl mx-auto">
    <div class="reveal section-content">
      <div class="section-title">
        <span class="section-title-text">Contact</span>
        <span class="section-title-line"></span>
      </div>
      <div class="glass-card max-w-xl">
        <p class="text-lg text-text-secondary leading-relaxed mb-8">
          I'm always open to interesting conversations and opportunities.
        </p>
        <div class="flex flex-col gap-4">
          <a
            href="https://linkedin.com/in/your-username"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-link"
          >
            LinkedIn<span class="cursor-blink"></span>
          </a>
          <a
            href="mailto:shengh@mit.edu"
            class="contact-link"
          >
            shengh@mit.edu<span class="cursor-blink"></span>
          </a>
          <a
            href="/resume.pdf"
            download
            class="contact-link"
            style="color: rgba(20, 184, 166, 0.8);"
          >
            download resume.pdf<span class="cursor-blink"></span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
