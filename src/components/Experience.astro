---
import { experience } from '../data/projects';
---

<section id="experience" class="section-bg relative py-24 md:py-32 px-6 md:px-[8%] border-t border-border overflow-hidden">
  <div class="section-bg-glow" style="bottom: 10%; right: -15%;"></div>
  <canvas id="exp-particles" aria-hidden="true"></canvas>
  <div class="max-w-5xl mx-auto relative z-10">
    <div class="reveal section-content">
      <div class="section-title">
        <span class="section-title-text">Experience</span>
        <span class="section-title-line"></span>
        <span class="exp-tracker">[TRACKING {experience.length} MISSIONS]</span>
      </div>

      <div class="exp-timeline reveal-stagger">
        <div class="exp-energy-line"></div>
        {experience.map((exp, i) => {
          const isActive = exp.period.includes('Present');
          const logNum = String(i + 1).padStart(3, '0');
          return (
            <div class="exp-mission">
              <div class="exp-mission-meta">
                <div class="exp-node">
                  <div class="exp-node-ring"></div>
                  <div class="exp-node-diamond"></div>
                </div>
                <span class="exp-log-label">[LOG {logNum}]</span>
                <span class="exp-meta-line"></span>
                <span class="exp-period">{exp.period}</span>
              </div>
              <div class="exp-card">
                <div class="exp-card-trace">
                  <svg class="exp-trace-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
                    <rect class="exp-trace-rect" x="0.5" y="0.5" width="99" height="99" rx="7" />
                  </svg>
                </div>
                <div class="exp-card-scan"></div>
                <div class="exp-card-content">
                  <h3 class="exp-card-role">{exp.role}</h3>
                  <p class="exp-card-company">{exp.company}</p>
                  <span class={`exp-status ${isActive ? 'active' : 'completed'}`}>
                    <span class="exp-status-dot"></span>
                    STATUS: {isActive ? 'ACTIVE' : 'COMPLETED'}
                  </span>
                  <ul class="exp-card-desc">
                    {exp.description.map((desc) => (
                      <li>{desc}</li>
                    ))}
                  </ul>
                  {exp.skills && (
                    <div class="flex flex-wrap gap-1.5 mt-3">
                      {exp.skills.map(s => <span class="tech-chip text-[0.6rem]">{s}</span>)}
                    </div>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .exp-tracker {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.6rem;
    color: rgba(20, 184, 166, 0.35);
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .exp-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .exp-energy-line {
    position: absolute;
    left: 2.25rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: linear-gradient(to bottom, rgba(20, 184, 166, 0.05), rgba(20, 184, 166, 0.3), rgba(20, 184, 166, 0.05));
  }

  .exp-energy-line::before {
    content: '';
    position: absolute;
    top: -8px;
    left: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(20, 184, 166, 0.5);
    filter: blur(2px);
    animation: energyPulse 2s ease-in-out infinite;
  }

  .exp-energy-line::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(20, 184, 166, 0.15);
    filter: blur(2px);
  }

  @keyframes energyPulse {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.3); }
  }

  .exp-mission {
    position: relative;
    padding-left: 4rem;
    padding-bottom: 2.5rem;
  }

  .exp-mission:last-child {
    padding-bottom: 0;
  }

  .exp-mission-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
    position: relative;
  }

  .exp-node {
    position: relative;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-left: -4.7rem;
  }

  .exp-node-diamond {
    width: 9px;
    height: 9px;
    background: rgba(20, 184, 166, 0.35);
    border: 1.5px solid rgba(20, 184, 166, 0.6);
    transform: rotate(45deg);
    position: relative;
    z-index: 2;
  }

  .exp-node-ring {
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 1px solid rgba(20, 184, 166, 0.15);
    animation: nodePulse 2.5s ease-in-out infinite;
  }

  .exp-mission:last-child .exp-node-ring {
    animation: nodePulse 2.5s ease-in-out infinite;
  }

  @keyframes nodePulse {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.5); opacity: 0.1; }
  }

  .exp-log-label {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(20, 184, 166, 0.8);
    letter-spacing: 0.08em;
    white-space: nowrap;
    flex-shrink: 0;
    text-shadow: 0 0 8px rgba(20, 184, 166, 0.25);
  }

  .exp-meta-line {
    flex: 1;
    height: 0;
    border-bottom: 1px dashed rgba(20, 184, 166, 0.12);
    min-width: 1rem;
  }

  .exp-period {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.65rem;
    font-weight: 600;
    color: rgba(20, 184, 166, 0.7);
    letter-spacing: 0.08em;
    flex-shrink: 0;
    white-space: nowrap;
    text-shadow: 0 0 8px rgba(20, 184, 166, 0.2);
  }

  .exp-card {
    position: relative;
    background: rgba(26, 26, 26, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(20, 184, 166, 0.1);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    transition: border-color 0.3s, box-shadow 0.3s;
    overflow: hidden;
  }

  .exp-card:hover {
    border-color: rgba(20, 184, 166, 0.25);
    box-shadow: 0 0 25px rgba(20, 184, 166, 0.05), inset 0 0 20px rgba(20, 184, 166, 0.02);
  }

  .exp-card-scan {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0;
  }

  .exp-card:hover .exp-card-scan {
    opacity: 1;
  }

  .exp-card-scan::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(20, 184, 166, 0.12), transparent);
    animation: scanSweep 2.5s ease-in-out infinite;
  }

  @keyframes scanSweep {
    0% { top: -1px; }
    100% { top: 100%; }
  }

  .exp-card-trace {
    position: absolute;
    inset: -1px;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .exp-card:hover .exp-card-trace {
    opacity: 1;
  }

  .exp-trace-svg {
    width: 100%;
    height: 100%;
  }

  .exp-trace-rect {
    fill: none;
    stroke: rgba(20, 184, 166, 0.25);
    stroke-width: 1;
    stroke-dasharray: 400;
    stroke-dashoffset: 400;
    animation: borderTrace 0.8s ease-out forwards;
  }

  @keyframes borderTrace {
    to { stroke-dashoffset: 0; }
  }

  .exp-card-content {
    position: relative;
    z-index: 3;
  }

  .exp-card-role {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: 0.02em;
    margin-bottom: 0.15rem;
    text-shadow: 0 0 12px rgba(20, 184, 166, 0.12);
  }

  .exp-card-company {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .exp-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .exp-status.active {
    color: #22c55e;
    text-shadow: 0 0 10px rgba(34, 197, 94, 0.35);
  }

  .exp-status.completed {
    color: rgba(20, 184, 166, 0.7);
    text-shadow: 0 0 8px rgba(20, 184, 166, 0.2);
  }

  .exp-status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }

  .exp-status.active .exp-status-dot {
    animation: statusBlink 1.5s ease-in-out infinite;
  }

  @keyframes statusBlink {
    0%, 100% { opacity: 1; box-shadow: 0 0 6px currentColor; }
    50% { opacity: 0.3; box-shadow: none; }
  }

  .exp-card-desc {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .exp-card-desc li {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    padding-left: 0.75rem;
    position: relative;
  }

  .exp-card-desc li::before {
    content: '\25B8';
    position: absolute;
    left: 0;
    color: rgba(20, 184, 166, 0.4);
  }

  #exp-particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  @media (max-width: 1023px) {
    .exp-mission {
      padding-left: 3.5rem;
    }

    .exp-node {
      margin-left: -4.2rem;
    }

    .exp-tracker {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .exp-energy-line {
      display: none;
    }

    .exp-mission {
      padding-left: 0;
    }

    .exp-mission-meta {
      margin-left: 0;
    }

    .exp-node {
      margin-left: 0;
      width: 18px;
      height: 18px;
    }

    .exp-node-diamond {
      width: 7px;
      height: 7px;
    }

    .exp-node-ring {
      display: none;
    }

    .exp-card-scan,
    .exp-card-trace {
      display: none;
    }

    .exp-tracker {
      display: none;
    }
  }
</style>

<script>
(function() {
  const canvas = document.getElementById('exp-particles');
  if (!canvas) return;

  let animId;
  let particles = [];
  let w = 0, h = 0;

  function initParticles() {
    const section = canvas.closest('section');
    if (!section) return;

    const rect = section.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = rect.width;
    h = rect.height;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';

    const ctx = canvas.getContext('2d');
    ctx.scale(dpr, dpr);

    const isMobile = window.matchMedia('(max-width: 767px)').matches;
    const numParticles = isMobile ? 15 : 35;
    particles = Array.from({ length: numParticles }, function() {
      return {
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.25,
        vy: (Math.random() - 0.5) * 0.25,
        r: Math.random() * 1.5 + 0.3,
        a: Math.random() * 0.25 + 0.04,
      };
    });

    var maxConnDist = isMobile ? 80 : 120;

    function draw() {
      ctx.clearRect(0, 0, w, h);

      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0) { p.x = 0; p.vx *= -1; }
        if (p.x > w) { p.x = w; p.vx *= -1; }
        if (p.y < 0) { p.y = 0; p.vy *= -1; }
        if (p.y > h) { p.y = h; p.vy *= -1; }

        ctx.fillStyle = 'rgba(20, 184, 166, ' + p.a + ')';
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }

      for (var i = 0; i < particles.length; i++) {
        for (var j = i + 1; j < particles.length; j++) {
          var dx = particles[i].x - particles[j].x;
          var dy = particles[i].y - particles[j].y;
          var dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < maxConnDist) {
            var alpha = 0.025 * (1 - dist / maxConnDist);
            ctx.strokeStyle = 'rgba(20, 184, 166, ' + alpha + ')';
            ctx.lineWidth = 0.5;
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.stroke();
          }
        }
      }

      animId = requestAnimationFrame(draw);
    }

    draw();
  }

  var observer = new IntersectionObserver(function(entries) {
    for (var e of entries) {
      if (!e.isIntersecting && animId) {
        cancelAnimationFrame(animId);
        animId = 0;
      } else if (e.isIntersecting && !animId) {
        initParticles();
      }
    }
  }, { threshold: 0 });
  observer.observe(canvas);

  var resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function() {
      if (animId) {
        cancelAnimationFrame(animId);
        animId = 0;
      }
      initParticles();
    }, 200);
  });
})();
</script>
