---
import { experience } from '../data/projects';
---

<section id="experience" class="py-24 md:py-32 px-6 md:px-[8%] border-t border-border">
  <div class="max-w-5xl mx-auto">
    <div class="reveal">
      <h2 class="text-xs uppercase tracking-widest text-text-muted/50 mb-12 font-mono">Experience</h2>

      <div class="space-y-12">
        {experience.map((exp, i) => (
          <div class="grid md:grid-cols-5 gap-4 md:gap-8">
            <div class="md:col-span-1">
              <p class="text-sm text-text-muted font-mono">{exp.period}</p>
            </div>
            <div class="md:col-span-4">
              <h3 class="text-base font-semibold text-text-primary mb-1">{exp.role}</h3>
              <p class="text-sm text-text-secondary mb-3">{exp.company}</p>
              <ul class="space-y-1.5">
                {exp.description.map((desc) => (
                  <li class="text-sm text-text-secondary flex items-start gap-2">
                    <span class="text-text-muted mt-[3px]">-</span>
                    {desc}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
