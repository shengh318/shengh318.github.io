---
import { experience } from '../data/projects';
import HudDiagnostic from './hud/HudDiagnostic.astro';
---

<section id="experience" class="section-bg py-24 md:py-32 px-6 md:px-[8%] border-t border-border">
  <HudDiagnostic />
  <div class="section-bg-glow" style="bottom: 10%; right: -15%;"></div>
  <div class="max-w-5xl mx-auto">
    <div class="reveal section-content">
      <div class="section-title">
        <span class="section-title-text">Experience</span>
        <span class="section-title-line"></span>
      </div>

      <div class="reveal exp-cards">
        <div class="exp-cards-line"></div>
        {experience.map((exp, i) => (
          <div class="exp-card glass-card">
            <div class="exp-card-marker"></div>
            <div class="exp-card-body">
              <div class="exp-card-header">
                <h3 class="exp-card-title">{exp.role}</h3>
                <p class="exp-card-meta">{exp.company} &middot; {exp.period}</p>
              </div>
              <ul class="exp-card-desc">
                {exp.description.map((desc) => (
                  <li>{desc}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
